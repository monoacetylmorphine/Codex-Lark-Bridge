{
  "env": {
    "OPENAI_API_KEY": "${OPENAI_API_KEY}",
    "DEEPSEEK_API_KEY": "${DEEPSEEK_API_KEY}",
    "TAVILY_API_KEY": "${TAVILY_API_KEY}",
    "LANGFUSE_SECRET_KEY": "${LANGFUSE_SECRET_KEY}",
    "LANGFUSE_PUBLIC_KEY": "${LANGFUSE_PUBLIC_KEY}"
  },
  "agents": {
    "defaults": {
      "workspace": "/home/node/.openclaw/workspace",
      "contextInjection": "continuation-skip",
      "heartbeat": {
        "every": "0m"
      },
      "skipOptionalBootstrapFiles": [
        "HEARTBEAT.md"
      ],
      "startupContext": {
        "enabled": true,
        "applyOn": [
          "new",
          "reset"
        ],
        "dailyMemoryDays": 3,
        "maxFileBytes": 32768,
        "maxFileChars": 2400,
        "maxTotalChars": 24000
      },
      "contextLimits": {
        "memoryGetMaxChars": 50000,
        "memoryGetDefaultLines": 120,
        "postCompactionMaxChars": 10000
      },
      "imageQuality": "auto",
      "userTimezone": "Asia/Shanghai",
      "timeFormat": "24",
      "models": {
        "custom-ai-soulecho-cc/gpt-5.6-sol": {
          "alias": "GPT-5.6-SOL"
        },
        "custom-ai-soulecho-cc/gpt-5.6-terra": {
          "alias": "GPT-5.6-TERRA"
        },
        "deepseek/deepseek-v4-flash": {
          "alias": "DeepSeek-V4-FLASH"
        },
        "deepseek/deepseek-v4-pro": {
          "alias": "DeepSeek-V4-PRO"
        }
      },
      "model": {
        "primary": "custom-ai-soulecho-cc/gpt-5.6-sol",
        "fallbacks": [
          "custom-ai-soulecho-cc/gpt-5.6-terra",
          "deepseek/deepseek-v4-pro"
        ]
      },
      "memorySearch": {
        "provider": "none"
      },
      "reasoningDefault": "stream",
      "thinkingDefault": "low",
      "compaction": {
        "mode": "safeguard",
        "timeoutSeconds": 600,
        "reserveTokensFloor": 80000,
        "keepRecentTokens": 200000,
        "recentTurnsPreserve": 5,
        "maxHistoryShare": 0.4,
        "identifierPolicy": "strict",
        "qualityGuard": {
          "enabled": true,
          "maxRetries": 2
        },
        "midTurnPrecheck": {
          "enabled": true
        },
        "postIndexSync": "async",
        "postCompactionSections": [
          "Session Startup",
          "Red Lines"
        ],
        "truncateAfterCompaction": true,
        "maxActiveTranscriptBytes": "2.8mb",
        "notifyUser": true,
        "memoryFlush": {
          "enabled": true,
          "model": "deepseek/deepseek-v4-flash",
          "softThresholdTokens": 10000,
          "forceFlushTranscriptBytes": "3mb",
          "systemPrompt": "Session nearing compaction. Store durable memories now.",
          "prompt": "Write any lasting notes to memory/YYYY-MM-DD.md; reply with the exact silent token NO_REPLY if nothing to store."
        }
      }
    },
    "list": [
