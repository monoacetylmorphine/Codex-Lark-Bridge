      "staleMs": 1800000,
      "maxHoldMs": 180000
    },
    "agentToAgent": {
      "maxPingPongTurns": 10
    },
    "maintenance": {
      "mode": "warn",
      "pruneAfter": "30d",
      "maxEntries": 500,
      "resetArchiveRetention": "30d",
      "maxDiskBytes": "500mb",
      "highWaterBytes": "400mb"
    }
  },
  "tools": {
